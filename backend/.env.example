# Campus Lost & Found Platform Configuration
PROJECT_NAME="Campus Lost & Found Platform"
ENVIRONMENT="development"
PORT=8000
HOST="0.0.0.0"

# PostgreSQL Database Connection
# If PostgreSQL is running locally or in Docker:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/campus_lostfound"
# Fallback SQLite is automatically used if PostgreSQL is not reachable in development.
# Or set explicitly: DATABASE_URL="sqlite:///./lostfound.db"

# File Storage
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_TYPES=["image/jpeg", "image/png", "image/webp", "image/gif"]
